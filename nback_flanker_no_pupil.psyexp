        <Param val="if fixation.status == STARTED and not iti_trigger_started:&amp;#10;    win.callOnFlip(dev.activate_line, bitmask=iti_start_code)&amp;#10;    iti_trigger_started = True&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
